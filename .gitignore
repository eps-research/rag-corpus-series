# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
dist/
build/
*.so

# Jupyter
.ipynb_checkpoints/
*.ipynb_checkpoints

# Data files (large - stored on Zenodo not GitHub)
*.fits
*.hdf5
*.h5

# OS
.DS_Store
Thumbs.db

# Logs
*.log
*.json
*.jsonl
*.csv
quickstart_*.png
.ipynb_checkpoints/
papers/*.aux
papers/*.out
papers/*.log

# Corpus data files are the point of this repository (see .gitignore history)
!examples/**/*.json
!examples/**/*.jsonl

# Patch-script scaffolding — never deposit
*.bak
*.bak[0-9]
*.orig

# v7.3 HI catalogue tables, bundled deliberately (md5 d11d4c8b7e1dd5f479f961bca7639b70)
!examples/hi/rotation_curve_corpus_v7.1_flat.csv
!examples/highschool/rotation_curve_corpus_v7.1_flat.csv

# MCP server: every file under mcp-server/ is source and must be committed,
# including JSON (the global *.json rule above silently dropped such files).
!mcp-server/**/*.json
mcp-server/.venv/
mcp-server/data/
mcp-server/dist/
.pytest_cache/
